#! /bin/sh
# Build the TCPR kernel module against the RUNNING kernel and install it so
# `modprobe tcpr` works. Run as root:  sudo ./install-module
#
# Why: the module must match the running kernel's version magic. This builds
# in a clean temp dir (the in-tree module/ dir may hold root-owned artifacts
# from a previous build) and installs the result under /lib/modules/.../extra.
set -e

here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
kver=$(uname -r)
kbuild=/lib/modules/$kver/build

if [ ! -d "$kbuild" ]; then
	echo "Missing kernel headers: $kbuild" >&2
	echo "Install them, e.g.:  apt-get install linux-headers-$kver" >&2
	exit 1
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$tmp/module"
cp "$root/module/module.c" "$root/module/filter.c" "$root/module/Makefile" "$tmp/module/"
cp -r "$root/include" "$tmp/include"

echo "Building tcpr.ko for kernel $kver ..."
make -C "$tmp/module"

dest=/lib/modules/$kver/extra/tcpr.ko
echo "Installing -> $dest"
install -D "$tmp/module/tcpr.ko" "$dest"
depmod "$kver"

echo "Done. Verify with:  modinfo tcpr   (vermagic should be $kver)"
echo "Then load with:     modprobe tcpr"
